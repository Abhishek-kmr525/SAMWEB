# Copy this file to .deploy.env on cPanel and update the values.
# Keep the repository checkout outside public_html.
SAM_REPO_URL=git@github.com:YOUR_ORG/YOUR_REPOSITORY.git
SAM_REPO_DIR=/home/CPANEL_USER/repositories/samrecover
SAM_PUBLIC_DIR=/home/CPANEL_USER/public_html
SAM_BRANCH=main

# Optional. The deployment fails if this URL does not return HTTP 2xx/3xx.
SAM_HEALTHCHECK_URL=https://samrecover.com/

